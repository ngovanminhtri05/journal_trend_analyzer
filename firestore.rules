rules_version = '2';

// Firestore Security Rules (Firebase Admin Panel).
//
// The `admin_events` collection mirrors real Analytics events purely so the
// in-app admin Logs screen has instant, queryable data. Every other
// Firebase-console-only operation (users, Remote Config, cross-user Storage,
// push) goes through Cloud Functions instead, which check the same `admin`
// custom claim server-side.
service cloud.firestore {
  match /databases/{database}/documents {
    match /admin_events/{eventId} {
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'timestamp', 'params']);
      allow read: if request.auth != null && request.auth.token.admin == true;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
