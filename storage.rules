rules_version = '2';

// Firebase Storage Security Rules (Lab 03).
//
// The Firebase client API keys in google-services.json / firebase_options.dart
// are public by design; access is enforced here, not by key secrecy. PDF reports
// are namespaced per user (reports/{uid}/...) and only that signed-in user may
// read or write their own folder.
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
